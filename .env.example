# Supabase → Settings → API Keys (Publishable and secret API keys 탭)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# sb_publishable_... 클라이언트 노출 OK, RLS 적용
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... 서버 전용. NEXT_PUBLIC_ 붙이지 말 것. 업로드 스크립트·Route Handler에서만 사용
SUPABASE_SECRET_KEY=

# Supabase → Connect → ORMs → Prisma
# 런타임(Prisma Client): Transaction pooler, 6543
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# CLI(migrate/studio): Session/Direct, 5432
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Storage 버킷명
SUPABASE_STORAGE_BUCKET=videos
