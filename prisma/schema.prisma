generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Content {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(64)
  title         String   @db.VarChar(200)
  description   String?
  durationSec   Int
  masterPath    String   @db.VarChar(255)
  posterPath    String?  @db.VarChar(255)
  thumbnailPath String?  @db.VarChar(255)
  trailerPath   String?  @db.VarChar(255)
  thumbsVttPath String?  @db.VarChar(255)
  /// 인코딩된 렌디션 높이(px). 예: [1080, 720, 480]. 상세 화면 화질 표기용.
  renditions    Int[]    @default([])
  /// 엔딩 크레딧 시작 위치(초). 다음 화 버튼이 뜨는 시점. null 이면 끝 30초 전.
  creditsStartSec Int?
  seriesId      String?  @db.Uuid
  episodeNo     Int?
  createdAt     DateTime @default(now()) @db.Timestamptz()
  updatedAt     DateTime @updatedAt @db.Timestamptz()

  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  subtitles Subtitle[]
  histories WatchHistory[]

  @@unique([seriesId, episodeNo])
}

/// 에피소드 묶음. slug 는 Content.slug 와 같은 네임스페이스(/title/[slug])를 쓰므로 겹치지 않게.
model Series {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(64)
  title         String   @db.VarChar(200)
  description   String?
  posterPath    String?  @db.VarChar(255)
  thumbnailPath String?  @db.VarChar(255)
  trailerPath   String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.Timestamptz()
  updatedAt     DateTime @updatedAt @db.Timestamptz()

  episodes Content[]
}

model Subtitle {
  id        String  @id @default(uuid()) @db.Uuid
  contentId String  @db.Uuid
  lang      String  @db.VarChar(16)
  label     String  @db.VarChar(50)
  vttPath   String  @db.VarChar(255)
  isDefault Boolean @default(false)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, lang])
}

model Profile {
  id        String   @id @db.Uuid
  nickname  String   @db.VarChar(20)
  avatarUrl String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  histories WatchHistory[]
}

model WatchHistory {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  contentId     String   @db.Uuid
  positionSec   Int      @default(0)
  completed     Boolean  @default(false)
  lastWatchedAt DateTime @default(now()) @db.Timestamptz()
  createdAt     DateTime @default(now()) @db.Timestamptz()
  updatedAt     DateTime @updatedAt @db.Timestamptz()

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId, lastWatchedAt(sort: Desc)])
}
